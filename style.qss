/* --- Global Settings --- */
QWidget {
    color: #E0E0E0;
    font-family: 'Segoe UI', 'Roboto', 'Inter', sans-serif;
    font-size: 13px;
}

QMainWindow, QWidget#MainContent {
    background-color: #121212;
}

/* --- Tab Bar Styling --- */
QTabWidget::pane {
    border-top: 1px solid #333;
    background: #121212;
}

QTabBar::tab {
    background: #1E1E1E;
    color: #888;
    padding: 10px 30px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background: #252525;
    color: #2ECC71;
    border-bottom: 3px solid #2ECC71;
}

QTabBar::tab:hover {
    background: #2A2A2A;
    color: #BBB;
}

/* --- Bottom Strip ScrollArea & ScrollBar (NEW) --- */
QScrollArea#BottomScrollArea {
    background: #080808;
    border: none;
    border-top: 1px solid #333;
}

QWidget#BottomStripContent {
    background-color: #121212;
}

/* แถบเลื่อนแนวนอนด้านล่าง */
QScrollBar:horizontal {
    border: none;
    background: #111;
    height: 8px;
    margin: 0px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: #333;
    min-width: 40px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #2ECC71; /* กลายเป็นสีเขียวเมื่อเอาเมาส์จี้ */
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* --- Vertical ScrollBar --- */
QScrollBar:vertical {
    border: none;
    background: #121212;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #333;
    min-height: 30px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #444;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* --- Node Card Styling (Bottom Strip) --- */
/* ใช้ Selector QPushButton เพื่อให้กระทบกับปุ่มที่เราใช้ทำการ์ด */
QPushButton#NodeCard {
    background-color: #121212;
    border: 1px solid #333;
    border-radius: 12px;
    text-align: left;
}

QPushButton#NodeCard:hover {
    background-color: #1A1A1A;
    border: 1px solid #444;
}

QPushButton#NodeCard:checked {
    background-color: rgba(46, 204, 113, 0.08);
    border: 2px solid #2ECC71;
}

/* --- Elements inside Card --- */
QLabel#NodeTitle {
    color: #777;
    font-weight: bold;
    font-size: 10px;
    text-transform: uppercase;
}

QLabel#ValueDisplay {
    color: #FFFFFF;
    font-size: 18px;
    font-weight: bold;
    font-family: 'Consolas';
}

QLabel#PercDisplay {
    color: #2ECC71;
    font-size: 12px;
    font-weight: bold;
}

/* --- Bottom Strip ScrollArea --- */
QScrollArea#BottomScrollArea {
    background: #080808;
    border: none;
    border-top: 1px solid #333;
}

/* ปรับแต่ง Horizontal ScrollBar ให้ Slim และสวยงาม */
QScrollArea#BottomScrollArea QScrollBar:horizontal {
    border: none;
    background: #111;
    height: 8px;
    margin: 0px;
    border-radius: 4px;
}

QScrollArea#BottomScrollArea QScrollBar::handle:horizontal {
    background: #333;
    min-width: 40px;
    border-radius: 4px;
}

QScrollArea#BottomScrollArea QScrollBar::handle:horizontal:hover {
    background: #2ECC71; /* Highlight สีเขียวตอนเอาเมาส์วาง */
}

QScrollArea#BottomScrollArea QScrollBar::add-line:horizontal, 
QScrollArea#BottomScrollArea QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* --- Node Card (QPushButton) --- */
QPushButton#NodeCard {
    background: #121212;
    border: 1px solid #333;
    border-radius: 10px;
}

QPushButton#NodeCard:hover {
    background: #1a1a1a;
}

QPushButton#NodeCard:checked {
    background: #121212;
    border: 4px solid #2ECC71;
}

/* --- Labels Inside Card --- */
QLabel#NodeTitle {
    color: #666;
    font-size: 9px; /* ปรับขนาดฟอนต์ให้พอดี */
    font-weight: bold;
    text-transform: uppercase;
    background: transparent;
}

QLabel#PercDisplay {
    color: #2ECC71;
    font-size: 13px;
    font-weight: bold;
    font-family: 'Consolas';
    background: transparent;
}

QLabel#ValueDisplay {
    color: #eee;
    font-size: 17px;
    font-weight: bold;
    font-family: 'Consolas';
    background: transparent;
}
